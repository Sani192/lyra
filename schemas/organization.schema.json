{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lyra.example/schemas/organization.schema.json",
  "title": "Lyra Organization Schema",
  "description": "Defines tenant configurations, including names, active status, and custom security/privacy policies.",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "description": "Unique URL-safe identifier for the organization."
    },
    "name": {
      "type": "string",
      "description": "Display name of the organization."
    },
    "projects": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of active projects registered under the organization."
    },
    "status": {
      "type": "string",
      "enum": ["active", "suspended"],
      "description": "Lifecycle state of the organization."
    },
    "security_policies": {
      "type": "object",
      "properties": {
        "transcript_retention_days": {
          "type": "integer",
          "minimum": 0
        },
        "recording_retention_days": {
          "type": "integer",
          "minimum": 0
        },
        "allowed_protocols": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["REST", "OpenAPI", "MCP"]
          }
        }
      },
      "required": ["transcript_retention_days", "recording_retention_days", "allowed_protocols"],
      "additionalProperties": false
    }
  },
  "required": ["organization_id", "name", "status", "security_policies"],
  "additionalProperties": false,
  "x-documentationStatus": "Approved",
  "x-intendedUse": "Authoritative validation of tenant configurations loaded into the administration panel."
}
