{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lyra.example/schemas/contract.schema.json",
  "title": "Lyra Consumer Contract Schema",
  "description": "Defines the integration contract between a consumer application and Lyra, including security, versioning, and registered capabilities.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique contract identifier."
    },
    "organization_id": {
      "type": "string",
      "description": "The tenant organization ID."
    },
    "project_id": {
      "type": "string",
      "description": "The target project ID."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the contract."
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "capability.schema.json"
      },
      "description": "List of capabilities declared by this consumer."
    },
    "authentication": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["apiKey", "oauth2", "mutualTLS", "none"]
        },
        "config": {
          "type": "object",
          "description": "API key headers, OAuth2 scopes, or certificate configurations."
        }
      },
      "required": ["type"],
      "additionalProperties": true
    },
    "observability": {
      "type": "object",
      "properties": {
        "webhook_url": {
          "type": "string",
          "format": "uri"
        },
        "events_enabled": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["webhook_url"],
      "additionalProperties": false
    }
  },
  "required": ["id", "organization_id", "project_id", "version", "capabilities", "authentication"],
  "additionalProperties": false,
  "x-documentationStatus": "Approved",
  "x-intendedUse": "Authoritative validation of consumer contracts during registration and integration setup."
}
